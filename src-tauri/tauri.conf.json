{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emblem Vectorizer",
  "version": "0.1.0",
  "identifier": "com.emblem.vectorizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Emblem Vectorizer",
        "width": 1100,
        "height": 840,
        "minWidth": 420,
        "minHeight": 540,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Emblème vers SVG détouré",
    "longDescription": "Convertit un emblème posé sur fond blanc en SVG vectoriel sans fond, entièrement sur la machine.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
