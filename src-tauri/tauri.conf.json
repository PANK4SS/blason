{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blason",
  "version": "0.1.0",
  "identifier": "com.blason.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blason",
        "width": 620,
        "height": 620,
        "minWidth": 400,
        "minHeight": 460,
        "dragDropEnabled": false,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "category": "Graphics and Design",
    "publisher": "PANK4SS",
    "copyright": "Copyright (c) 2026 PANK4SS",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Emblème vers SVG détouré",
    "longDescription": "Blason convertit un emblème posé sur fond blanc en SVG vectoriel sans fond, entièrement sur la machine.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
